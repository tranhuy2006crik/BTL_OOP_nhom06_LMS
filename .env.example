# Copy this file to .env and replace the values for your local machine.
DB_PASSWORD=REPLACE_WITH_LOCAL_LMS_APP_PASSWORD

# Optional: generate locally with PowerShell or `openssl rand -base64 32`.
# Use a stable secret so previously issued JWTs remain valid after restart.
LMS_JWT_SECRET=
LMS_JWT_EXPIRATION_SECONDS=3600

# Configure an SMTP service to deliver password-reset emails.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@localhost

# Public base URL used in reset links (no trailing slash).
LMS_BASE_URL=http://localhost:8080
