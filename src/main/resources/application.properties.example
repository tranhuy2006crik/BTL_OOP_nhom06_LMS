spring.application.name=lms-system

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/lms_db}
spring.datasource.username=${DB_USERNAME:lms_app}
spring.datasource.password=${DB_PASSWORD}

# The schema is managed by the SQL scripts in src/main/resources/db.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

# Optional Base64-encoded 256-bit (or longer) HMAC key for JWT signing.
# Generate one with: openssl rand -base64 32
# If omitted, a random process-local key is generated; tokens expire on restart.
lms.jwt.secret=${LMS_JWT_SECRET:}
lms.jwt.expiration-seconds=${LMS_JWT_EXPIRATION_SECONDS:3600}
